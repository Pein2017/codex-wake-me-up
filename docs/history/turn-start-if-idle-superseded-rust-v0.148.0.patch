+use core_test_support::streaming_sse::StreamingSseChunk;
+use core_test_support::streaming_sse::start_streaming_sse_server;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use std::time::Duration;
+use tempfile::TempDir;
+use tokio::sync::oneshot;
+use tokio::time::timeout;
+use wiremock::MockServer;
+
+const DEFAULT_READ_TIMEOUT: Duration = Duration::from_secs(10);
+
+fn turn_start_params(thread_id: &str, text: &str) -> TurnStartParams {
+    TurnStartParams {
+        thread_id: thread_id.to_string(),
+        client_user_message_id: None,
+        input: vec![UserInput::Text {
+            text: text.to_string(),
+            text_elements: Vec::new(),
+        }],
+        ..Default::default()
+    }
+}
+
+async fn start_thread(mcp: &mut TestAppServer) -> Result<String> {
+    let ThreadStartResponse { thread, .. } = mcp
+        .start_thread(ThreadStartParams {
+            model: Some("mock-model".to_string()),
+            thread_source: Some(ThreadSource::User),
+            ..Default::default()
+        })
+        .await?;
+    Ok(thread.id)
+}
+
+async fn start_if_idle(
+    mcp: &mut TestAppServer,
+    thread_id: &str,
+    expected_last_turn_id: &str,
+    text: &str,
+) -> Result<Value> {
+    let request_id = mcp
+        .send_raw_request(
+            "turn/startIfIdle",
+            Some(json!({
+                "threadId": thread_id,
+                "expectedLastTurnId": expected_last_turn_id,
+                "input": [{ "type": "text", "text": text, "textElements": [] }]
+            })),
+        )
+        .await?;
+    timeout(DEFAULT_READ_TIMEOUT, mcp.read_response(request_id)).await?
+}
+
+async fn completed_thread(
+    include_guarded_response: bool,
+) -> Result<(MockServer, TempDir, TestAppServer, String, String)> {
+    let mut responses = vec![create_final_assistant_message_sse_response(
+        "first complete",
+    )?];
+    if include_guarded_response {
+        responses.push(create_final_assistant_message_sse_response(
+            "guarded complete",
+        )?);
+    }
+    let server = create_mock_responses_server_sequence_unchecked(responses).await;
+    let codex_home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri()).write(codex_home.path())?;
+    let mut mcp = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .build_initialized()
+        .await?;
+    let thread_id = start_thread(&mut mcp).await?;
+    let completed = mcp
+        .start_turn_and_wait_for_completion(turn_start_params(&thread_id, "first"))
+        .await?;
+    Ok((server, codex_home, mcp, thread_id, completed.turn.id))
+}
+
+#[tokio::test]
+async fn turn_start_if_idle_starts_when_latest_completed_turn_matches() -> Result<()> {
+    let (server, _codex_home, mut mcp, thread_id, last_turn_id) =
+        completed_thread(/*include_guarded_response*/ true).await?;
+
+    let response = start_if_idle(&mut mcp, &thread_id, &last_turn_id, "monitor result").await?;
+
+    assert_eq!(response["status"], "admitted");
+    assert_eq!(response["turn"]["status"], "inProgress");
+    assert!(
+        response["turn"]["id"]
+            .as_str()
+            .is_some_and(|id| !id.is_empty())
+    );
+    timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.read_stream_until_notification_message("turn/completed"),
+    )
+    .await??;
+    assert_eq!(server.received_requests().await?.len(), 2);
+    Ok(())
+}
+
+#[tokio::test]
+async fn turn_start_if_idle_rejects_stale_guard_without_provider_or_turn_side_effects() -> Result<()>
+{
+    let (server, _codex_home, mut mcp, thread_id, last_turn_id) =
+        completed_thread(/*include_guarded_response*/ false).await?;
+
+    let response = start_if_idle(&mut mcp, &thread_id, "stale-turn", "must not submit").await?;
+
+    assert_eq!(
+        response,
+        json!({
+            "status": "rejected",
+            "reason": "latestTurnMismatch",
+            "actualLastTurnId": last_turn_id,
+        })
+    );
+    assert_eq!(server.received_requests().await?.len(), 1);
+    Ok(())
+}
+
+#[tokio::test]
+async fn turn_start_if_idle_rejects_busy_thread_without_steering_or_queueing() -> Result<()> {
+    let (release_response, response_gate) = oneshot::channel();
+    let (server, _completions) = start_streaming_sse_server(vec![
+        vec![StreamingSseChunk {
+            gate: None,
+            body: responses::sse(vec![
+                responses::ev_response_created("resp-1"),
+                responses::ev_completed("resp-1"),
+            ]),
+        }],
+        vec![
+            StreamingSseChunk {
+                gate: None,
+                body: responses::sse(vec![responses::ev_response_created("resp-2")]),
+            },
+            StreamingSseChunk {
+                gate: Some(response_gate),
+                body: responses::sse(vec![responses::ev_completed("resp-2")]),
+            },
+        ],
+    ])
+    .await;
+    let codex_home = TempDir::new()?;
+    MockResponsesConfig::new(server.uri()).write(codex_home.path())?;
+    let mut mcp = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .build_initialized()
+        .await?;
+    let thread_id = start_thread(&mut mcp).await?;
+    let completed = mcp
+        .start_turn_and_wait_for_completion(turn_start_params(&thread_id, "first"))
+        .await?;
+    let active_request_id = mcp
+        .send_turn_start_request(turn_start_params(&thread_id, "active"))
+        .await?;
+    let _: Value = timeout(DEFAULT_READ_TIMEOUT, mcp.read_response(active_request_id)).await??;
+    timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.read_stream_until_notification_message("turn/started"),
+    )
+    .await??;
+
+    let response =
+        start_if_idle(&mut mcp, &thread_id, &completed.turn.id, "must not steer").await?;
+
+    assert_eq!(
+        response,
+        json!({
+            "status": "rejected",
+            "reason": "threadBusy",
+            "actualLastTurnId": null,
+        })
+    );
+    assert_eq!(server.requests().await.len(), 2);
+    release_response
+        .send(())
+        .expect("active response gate should remain open");
+    timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.read_stream_until_notification_message("turn/completed"),
+    )
+    .await??;
+    tokio::task::yield_now().await;
+    assert_eq!(server.requests().await.len(), 2);
+    Ok(())
+}
