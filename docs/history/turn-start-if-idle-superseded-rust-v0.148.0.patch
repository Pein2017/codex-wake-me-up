+pub(super) async fn start_if_idle_at(
+    session: &Arc<Session>,
+    request: TurnInputRequest,
+    submission_id: String,
+    expected_last_turn_id: &str,
+) -> CodexResult<GuardedStartIfIdleSubmission> {
+    if session.input_queue.has_trigger_turn_mailbox_items().await {
+        return Ok(GuardedStartIfIdleSubmission::NotSubmitted {
+            reason: NotSubmittedReason::PendingTriggerTurn,
+        });
+    }
+
+    let turn_state = {
+        let mut active_turn = session.active_turn.lock().await;
+        if active_turn.is_some() {
+            return Ok(GuardedStartIfIdleSubmission::NotSubmitted {
+                reason: NotSubmittedReason::NotIdle,
+            });
+        }
+        let live_thread = session
+            .live_thread_for_persistence("guarded turn start")
+            .map_err(|error| CodexErr::Fatal(error.to_string()))?;
+        let stored_thread = live_thread
+            .read_thread(
+                /*include_archived*/ true, /*include_history*/ true,
+            )
+            .await
+            .map_err(|error| CodexErr::Fatal(error.to_string()))?;
+        let latest_turn = stored_thread
+            .history
+            .as_ref()
+            .and_then(|history| build_turns_from_rollout_items(&history.items).pop());
+        let Some(latest_turn) = latest_turn else {
+            return Ok(GuardedStartIfIdleSubmission::Rejected {
+                reason: GuardedStartIfIdleRejection::NoVisibleTurn,
+            });
+        };
+        if latest_turn.status != TurnStatus::Completed {
+            return Ok(GuardedStartIfIdleSubmission::Rejected {
+                reason: GuardedStartIfIdleRejection::LatestTurnNotCompleted {
+                    actual_last_turn_id: latest_turn.id,
+                },
+            });
+        }
+        if latest_turn.id != expected_last_turn_id {
+            return Ok(GuardedStartIfIdleSubmission::Rejected {
+                reason: GuardedStartIfIdleRejection::LatestTurnMismatch {
+                    actual_last_turn_id: latest_turn.id,
+                },
+            });
+        }
+        let active_turn = active_turn.get_or_insert_with(ActiveTurn::default);
+        Arc::clone(&active_turn.turn_state)
+    };
+    match finish_start_if_idle(
+        session,
+        request,
+        submission_id,
+        /*is_recovery*/ false,
+        turn_state,
+    )
+    .await?
+    {
+        TurnInputSubmission::Started { turn_id } => {
+            Ok(GuardedStartIfIdleSubmission::Started { turn_id })
+        }
+        TurnInputSubmission::NotSubmitted { reason } => {
+            Ok(GuardedStartIfIdleSubmission::NotSubmitted { reason })
+        }
+        TurnInputSubmission::Steered { .. } => {
+            unreachable!("guarded start-if-idle submission cannot steer")
+        }
+    }
+}
