+    pub(crate) async fn turn_start_if_idle(
+        &self,
+        request_id: ConnectionRequestId,
+        params: TurnStartIfIdleParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        validate_user_input_image_urls(&params.input)?;
+        if params.input.is_empty() {
+            return Err(invalid_request("input must not be empty"));
+        }
+        if params.expected_last_turn_id.is_empty() {
+            return Err(invalid_request("expectedLastTurnId must not be empty"));
+        }
+        if let Err(error) = Self::validate_v2_input_limit(&params.input) {
+            self.track_error_response(
+                &request_id,
+                &error,
+                Some(AnalyticsJsonRpcError::Input(InputError::TooLarge)),
+            );
+            return Err(error);
+        }
+
+        let thread_id = ThreadId::from_string(&params.thread_id)
+            .map_err(|error| invalid_request(format!("invalid thread id: {error}")))?;
+        let thread = match self.thread_manager.get_thread(thread_id).await {
+            Ok(thread) => thread,
+            Err(_) => {
+                return Ok(Some(
+                    TurnStartIfIdleResponse::Rejected {
+                        reason: TurnStartIfIdleRejectionReason::ThreadNotLoaded,
+                        actual_last_turn_id: None,
+                    }
+                    .into(),
+                ));
+            }
+        };
+        self.ensure_direct_input_allowed(&request_id, thread.as_ref())
+            .await?;
+        let input = params
+            .input
+            .into_iter()
+            .map(V2UserInput::into_core)
+            .collect();
+        let submission = thread
+            .start_turn_if_idle_at(
+                TurnInputRequest::new(TurnInput::UserInput {
+                    content: input,
+                    client_id: params.client_user_message_id,
+                })
+                .with_trace(self.request_trace_context(&request_id).await),
+                &params.expected_last_turn_id,
+            )
+            .await
+            .map_err(|error| {
+                let error = internal_error(format!("failed to submit guarded turn input: {error}"));
+                self.track_error_response(&request_id, &error, /*error_type*/ None);
+                error
+            })?;
+        let response = match submission {
+            GuardedStartIfIdleSubmission::Started { turn_id } => {
+                self.outgoing
+                    .record_request_turn_id(&request_id, &turn_id)
+                    .await;
+                TurnStartIfIdleResponse::Admitted {
+                    turn: Turn {
+                        id: turn_id,
+                        items: Vec::new(),
+                        items_view: TurnItemsView::NotLoaded,
+                        error: None,
+                        status: TurnStatus::InProgress,
+                        started_at: None,
+                        completed_at: None,
+                        duration_ms: None,
+                    },
+                }
+            }
+            GuardedStartIfIdleSubmission::NotSubmitted {
+                reason: NotSubmittedReason::NotIdle | NotSubmittedReason::PendingTriggerTurn,
+            } => TurnStartIfIdleResponse::Rejected {
+                reason: TurnStartIfIdleRejectionReason::ThreadBusy,
+                actual_last_turn_id: None,
+            },
+            GuardedStartIfIdleSubmission::NotSubmitted { reason } => {
+                return Err(internal_error(format!(
+                    "unexpected guarded turn rejection: {reason:?}"
+                )));
+            }
+            GuardedStartIfIdleSubmission::Rejected { reason } => match reason {
+                GuardedStartIfIdleRejection::NoVisibleTurn => TurnStartIfIdleResponse::Rejected {
+                    reason: TurnStartIfIdleRejectionReason::NoVisibleTurn,
+                    actual_last_turn_id: None,
+                },
+                GuardedStartIfIdleRejection::LatestTurnNotCompleted {
+                    actual_last_turn_id,
+                } => TurnStartIfIdleResponse::Rejected {
+                    reason: TurnStartIfIdleRejectionReason::LatestTurnNotCompleted,
+                    actual_last_turn_id: Some(actual_last_turn_id),
+                },
+                GuardedStartIfIdleRejection::LatestTurnMismatch {
+                    actual_last_turn_id,
+                } => TurnStartIfIdleResponse::Rejected {
+                    reason: TurnStartIfIdleRejectionReason::LatestTurnMismatch,
+                    actual_last_turn_id: Some(actual_last_turn_id),
+                },
+            },
+        };
+        Ok(Some(response.into()))
+    }
