{
  "mcpServers": {
    "codex_wake_me_up": {
      "type": "stdio",
      "command": "conda",
      "args": ["run", "--no-capture-output", "-n", "ms", "python", "-u", "./scripts/mcp_server.py"],
      "cwd": ".",
      "required": false,
      "supports_parallel_tool_calls": false,
      "startup_timeout_sec": 15,
      "tool_timeout_sec": 30
    }
  }
}
